<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GachaWidget.Views.PreviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:GachaWidget.Converters"
    xmlns:vm="using:GachaCalendar.Core.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:HexToBrushConverter x:Key="HexBrush" />
        <conv:UrgencyToBrushConverter x:Key="UrgencyBrush" />
        <conv:SideToBrushConverter x:Key="SideBrush" />
    </UserControl.Resources>

    <!-- 根透明：任务栏背景由 WidBar 负责，不要自己画。
         每个 chip 两行：① 色点 + 游戏名 + 短倒计时（紧迫度上色）② 类型标记 + 内容标题 + 截止日。 -->
    <StackPanel
        Orientation="Horizontal"
        Spacing="8"
        Padding="6,0"
        VerticalAlignment="Center">

        <!-- 数据非实时时只留一个小圆点（比文字省空间），含义放 tooltip -->
        <Border
            Width="6"
            Height="6"
            VerticalAlignment="Center"
            Background="{ThemeResource SystemFillColorCautionBrush}"
            CornerRadius="3"
            ToolTipService.ToolTip="网络暂不可用，当前显示示例数据"
            Visibility="{x:Bind Vm.IsSample, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
        <Border
            Width="6"
            Height="6"
            VerticalAlignment="Center"
            Background="{ThemeResource TextFillColorTertiaryBrush}"
            CornerRadius="3"
            ToolTipService.ToolTip="网络暂不可用，当前显示上次成功缓存的数据"
            Visibility="{x:Bind Vm.IsCached, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

        <ItemsControl
            VerticalAlignment="Center"
            ItemsSource="{x:Bind Vm.Chips, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChipVm">
                    <Border
                        Width="180"
                        Padding="9,1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        ToolTipService.ToolTip="{x:Bind Tip}">
                        <Grid RowSpacing="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- ① 游戏 + 倒计时 + 截止日 -->
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="6"
                                    Height="6"
                                    VerticalAlignment="Center"
                                    Background="{x:Bind Color, Converter={StaticResource HexBrush}}"
                                    CornerRadius="3" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Text="{x:Bind GameName}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontSize="10.5"
                                    FontWeight="SemiBold"
                                    Foreground="{x:Bind UrgencyLevel, Converter={StaticResource UrgencyBrush}}"
                                    Text="{x:Bind Remaining}" />
                                <TextBlock
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    FontSize="9.5"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind Deadline}" />
                            </Grid>

                            <!-- ② 卡池/活动 + 内容标题（长角色列表允许折两行） -->
                            <Grid Grid.Row="1" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Top"
                                    Margin="0,2,0,0"
                                    FontSize="9"
                                    Foreground="{x:Bind IsGacha, Converter={StaticResource SideBrush}}"
                                    Text="{x:Bind SideGlyph}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxLines="2"
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            Text="暂无进行中"
            Visibility="{x:Bind Vm.HasNoChips, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>
</UserControl>
