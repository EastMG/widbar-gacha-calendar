<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GachaWidget.Views.PreviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GachaWidget.Controls"
    xmlns:conv="using:GachaWidget.Converters"
    xmlns:vm="using:GachaCalendar.Core.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:HexToBrushConverter x:Key="HexBrush" />
        <conv:GameNameToBrushConverter x:Key="GameBrush" />
        <conv:UrgencyStrongConverter x:Key="UrgencyStrong" />
        <conv:SideToBrushConverter x:Key="SideBrush" />
        <conv:FirstCharConverter x:Key="FirstChar" />
    </UserControl.Resources>

    <!-- 任务栏原生观感：不画卡片/边框，直接"图标 + 两行文字"。
         对齐 Windows 11 天气小组件的形态：图标承担"是什么"，主数字（剩余时间）承担"多急"，
         次要文字承担"具体内容"。 -->
    <StackPanel
        Orientation="Horizontal"
        Spacing="18"
        Padding="10,0"
        VerticalAlignment="Center">

        <!-- 数据非实时时只留一个小圆点（比文字省空间），含义放 tooltip -->
        <Border
            Width="6"
            Height="6"
            VerticalAlignment="Center"
            Background="{ThemeResource SystemFillColorCautionBrush}"
            CornerRadius="3"
            ToolTipService.ToolTip="网络暂不可用，当前显示示例数据"
            Visibility="{x:Bind Vm.IsSample, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
        <Border
            Width="6"
            Height="6"
            VerticalAlignment="Center"
            Background="{ThemeResource TextFillColorTertiaryBrush}"
            CornerRadius="3"
            ToolTipService.ToolTip="网络暂不可用，当前显示上次成功缓存的数据"
            Visibility="{x:Bind Vm.IsCached, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

        <ItemsControl
            VerticalAlignment="Center"
            ItemsSource="{x:Bind Vm.Chips, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="18" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChipVm">
                    <Grid
                        MaxWidth="136"
                        ColumnSpacing="6"
                        ToolTipService.ToolTip="{x:Bind Tip}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 游戏图标：任务栏上比文字更快识别"是哪款" -->
                        <controls:GameIcon
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            Glyph="{x:Bind FullName, Converter={StaticResource FirstChar}}"
                            IconUrl="{x:Bind IconUrl}" />

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="-1">
                            <!-- 主信息：还剩多久 + 截止日（紧迫度上色） -->
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock
                                    FontSize="12.5"
                                    FontWeight="SemiBold"
                                    Foreground="{x:Bind UrgencyLevel, Converter={StaticResource UrgencyStrong}}"
                                    Text="{x:Bind Remaining}" />
                                <TextBlock
                                    VerticalAlignment="Bottom"
                                    FontSize="9.5"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind Deadline}" />
                            </StackPanel>
                            <!-- 次信息：◆/⚑ 类型 + 内容标题 -->
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="8"
                                    Foreground="{x:Bind IsGacha, Converter={StaticResource SideBrush}}"
                                    Text="{x:Bind SideGlyph}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxWidth="104"
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            Text="暂无进行中"
            Visibility="{x:Bind Vm.HasNoChips, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>
</UserControl>
