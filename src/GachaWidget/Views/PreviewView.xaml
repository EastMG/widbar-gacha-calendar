<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GachaWidget.Views.PreviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:GachaWidget.Converters"
    xmlns:vm="using:GachaCalendar.Core.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:EnumEqualsToVisibilityConverter x:Key="EnumEquals" />
    </UserControl.Resources>

    <!-- 根透明：任务栏背景由 WidBar 负责，不要自己画 -->
    <StackPanel
        Orientation="Horizontal"
        Spacing="6"
        Padding="4,0"
        VerticalAlignment="Center">

        <!-- 数据不是最新时给一个小标记，避免把"示例/缓存"当成实时数据 -->
        <TextBlock
            VerticalAlignment="Center"
            FontSize="10"
            Foreground="{ThemeResource SystemFillColorCautionBrush}"
            Text="示例"
            ToolTipService.ToolTip="网络暂不可用，当前显示内置示例数据"
            Visibility="{x:Bind Vm.Status, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Sample}" />
        <TextBlock
            VerticalAlignment="Center"
            FontSize="10"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            Text="缓存"
            ToolTipService.ToolTip="网络暂不可用，当前显示上次成功缓存的数据"
            Visibility="{x:Bind Vm.Status, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Cached}" />

        <ItemsControl
            VerticalAlignment="Center"
            ItemsSource="{x:Bind Vm.Chips, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChipVm">
                    <Border
                        Padding="8,3"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        ToolTipService.ToolTip="{x:Bind Tip}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border
                                Width="3"
                                Height="14"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="1.5"
                                VerticalAlignment="Center" />
                            <TextBlock
                                VerticalAlignment="Center"
                                MaxWidth="76"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind GameName}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Text="{x:Bind Remaining}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            Text="暂无进行中"
            Visibility="{x:Bind Vm.HasNoChips, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>
</UserControl>
