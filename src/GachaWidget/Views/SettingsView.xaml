<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GachaWidget.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GachaWidget.Views"
    xmlns:conv="using:GachaWidget.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Windows 11 Fluent「设置卡片」版式（对齐 WinUI 3 Gallery / Windows 设置应用）：
        分区 = 16 号 SemiBold 标题 + 12 号 secondary 说明，下面是若干张卡片；
        卡片内一行 = 左列标题/说明 + 右列控件。深浅色全部走 ThemeResource，不写死颜色。
    -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="SectionDescTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="RowTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RowDescTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- 条目列表的行容器：撑满卡片宽度、去掉默认的 12px 内边距与 44px 最小高度 -->
        <Style
            x:Key="EntryRowContainerStyle"
            BasedOn="{StaticResource DefaultListViewItemStyle}"
            TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </UserControl.Resources>

    <!--
        宿主契约（WidBar.SDK.Hosting.SettingsHostWindow，1120×820dip 窗口）已经提供：
        48dip 标题栏 + ScrollViewer（Padding 24,16,24,8）+ 底部「保存 / 取消」。
        因此这里**不再套第二层 ScrollViewer、不再自带外边距**，内容要铺满宿主给到的宽度
        （≈1120 - 48 = 1072dip）；卡片本身仍按 Windows 设置 / WinUI SettingsCard 的规格做。
    -->
    <StackPanel
        MaxWidth="1040"
        HorizontalAlignment="Stretch"
        Spacing="24">

            <!-- ============================== 显示 ============================== -->
            <StackPanel Spacing="12">
                <StackPanel Spacing="2">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="显示" />
                    <TextBlock Style="{StaticResource SectionDescTextStyle}" Text="任务栏预览条与展开面板的展示方式。" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <Border
                        Padding="16,14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid ColumnSpacing="16" MinHeight="56">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="任务栏预览条显示几条" />
                                <TextBlock Style="{StaticResource RowDescTextStyle}" Text="1–3 条，按最近结束排序；更多内容点开面板看。" />
                            </StackPanel>
                            <!-- 只有 1–3 三个值：用下拉，不用 NumberBox。
                                 NumberBox 的 Compact 模式会弹出一个独立的大号滚动 Popup（用户反馈“按钮怎么这么大”），
                                 三选一用 NumberBox 是多余交互，而且和下面的「刷新间隔」不一致。 -->
                            <ComboBox
                                x:Name="PreviewItemsBox"
                                Grid.Column="1"
                                MinWidth="140"
                                VerticalAlignment="Center"
                                SelectionChanged="OnPreviewItemsChanged" />
                        </Grid>
                    </Border>

                    <Border
                        Padding="16,14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid ColumnSpacing="16" MinHeight="56">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="面板显示「卡池」列" />
                                <TextBlock Style="{StaticResource RowDescTextStyle}" Text="在展开面板里为每个条目显示所属卡池。" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="ShowGachaSwitch"
                                Grid.Column="1"
                                MinWidth="0"
                                VerticalAlignment="Center"
                                OffContent=""
                                OnContent=""
                                Toggled="OnSimpleToggled" />
                        </Grid>
                    </Border>

                    <Border
                        Margin="0,0,0,4"
                        Padding="16,14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid ColumnSpacing="16" MinHeight="56">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="面板显示「活动」列" />
                                <TextBlock Style="{StaticResource RowDescTextStyle}" Text="在展开面板里为每个条目显示进行中的活动。" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="ShowEventSwitch"
                                Grid.Column="1"
                                MinWidth="0"
                                VerticalAlignment="Center"
                                OffContent=""
                                OnContent=""
                                Toggled="OnSimpleToggled" />
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- ============================== 刷新 ============================== -->
            <StackPanel Spacing="12">
                <StackPanel Spacing="2">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="刷新" />
                    <TextBlock Style="{StaticResource SectionDescTextStyle}" Text="数据源多久拉一次。" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <Border
                        Padding="16,14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid ColumnSpacing="16" MinHeight="56">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="自动刷新" />
                                <TextBlock Style="{StaticResource RowDescTextStyle}" Text="按下面的间隔在后台重新拉取数据源。" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="AutoRefreshSwitch"
                                Grid.Column="1"
                                MinWidth="0"
                                VerticalAlignment="Center"
                                OffContent=""
                                OnContent=""
                                Toggled="OnSimpleToggled" />
                        </Grid>
                    </Border>

                    <Border
                        Margin="0,0,0,4"
                        Padding="16,14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid ColumnSpacing="16" MinHeight="56">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="刷新间隔" />
                                <TextBlock
                                    Style="{StaticResource RowDescTextStyle}"
                                    Text="数据源每 6 小时更新一轮；间隔比 6 小时短不会更新数据，只会多一次请求。倒计时每分钟在本地重算，所以数据抓取时间不影响剩余时间的精度。" />
                            </StackPanel>
                            <ComboBox
                                x:Name="RefreshIntervalBox"
                                Grid.Column="1"
                                MinWidth="140"
                                VerticalAlignment="Center"
                                SelectionChanged="OnRefreshIntervalChanged" />
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- ============================== 数据源 ============================== -->
            <StackPanel Spacing="12">
                <StackPanel Spacing="2">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="数据源" />
                    <TextBlock Style="{StaticResource SectionDescTextStyle}" Text="v0 只请求这一个公开静态快照，不在界面层访问第三方源。" />
                </StackPanel>

                <Border
                    Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="快照地址（JSON）" />
                            <TextBlock Style="{StaticResource RowDescTextStyle}" Text="默认是社区维护的公开快照；也可以换成本地或自建的镜像地址。" />
                        </StackPanel>
                        <TextBox
                            x:Name="FeedUrlBox"
                            PlaceholderText="https://…/latest.json"
                            TextChanged="OnFeedUrlChanged" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="CheckFeedButton"
                                Click="OnCheckFeedClick"
                                Content="检查数据" />
                            <Button Click="OnResetFeedClick" Content="恢复默认地址" />
                        </StackPanel>
                        <TextBlock
                            x:Name="CheckResultText"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            Text=""
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================== 条目 ============================== -->
            <StackPanel Spacing="12">
                <StackPanel Spacing="2">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="条目" />
                    <TextBlock Style="{StaticResource SectionDescTextStyle}" Text="28 款游戏的显隐与顺序，改动会实时同步到面板与预览条。" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <Border
                        Padding="16,14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid ColumnSpacing="16" MinHeight="56">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="显示与排序" />
                                <TextBlock Style="{StaticResource RowDescTextStyle}" Text="勾选 = 在面板与预览条里显示；上下箭头调整顺序。" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Click="OnResetEntriesClick"
                                Content="恢复默认" />
                        </Grid>
                    </Border>

                    <Border
                        Margin="0,0,0,4"
                        Padding="16,14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <ListView
                            x:Name="EntriesList"
                            Padding="0"
                            ItemContainerStyle="{StaticResource EntryRowContainerStyle}"
                            MaxHeight="380"
                            SelectionMode="None"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:SettingsEntryVm">
                                    <Border
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1">
                                        <Grid ColumnSpacing="12" MinHeight="40">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox
                                                MinWidth="0"
                                                VerticalAlignment="Center"
                                                Click="OnEntryCheckBoxClick"
                                                IsChecked="{x:Bind IsVisible, Mode=OneWay}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                MaxLines="1"
                                                Text="{x:Bind Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <Button
                                                Grid.Column="2"
                                                Width="32"
                                                Height="32"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                Click="OnMoveUpClick"
                                                Style="{StaticResource SubtleButtonStyle}"
                                                ToolTipService.ToolTip="上移">
                                                <FontIcon FontSize="12" Glyph="&#xE74A;" />
                                            </Button>
                                            <Button
                                                Grid.Column="3"
                                                Width="32"
                                                Height="32"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                Click="OnMoveDownClick"
                                                Style="{StaticResource SubtleButtonStyle}"
                                                ToolTipService.ToolTip="下移">
                                                <FontIcon FontSize="12" Glyph="&#xE74B;" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- ============================== 关于 ============================== -->
            <StackPanel Spacing="12">
                <StackPanel Spacing="2">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="关于" />
                    <TextBlock Style="{StaticResource SectionDescTextStyle}" Text="版本、游戏目录与数据来源。" />
                </StackPanel>

                <Border
                    Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="10">
                        <TextBlock
                            x:Name="AboutText"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <Border
                            Height="1"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="非官方信息聚合，与各游戏厂商无关；不收集任何数据。数据来自公开的官方公告与社区 Wiki。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
</UserControl>