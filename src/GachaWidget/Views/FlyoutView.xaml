<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GachaWidget.Views.FlyoutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GachaWidget.Controls"
    xmlns:conv="using:GachaWidget.Converters"
    xmlns:vm="using:GachaCalendar.Core.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:StringEqualsToVisibilityConverter x:Key="KindEquals" />
        <conv:StringNotEmptyToVisibilityConverter x:Key="NotEmpty" />
    </UserControl.Resources>

    <!-- 背景/材质由 WidBar 提供：这里根透明，不画底板 -->
    <Grid Background="Transparent" Padding="14,12,14,10" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部状态条 -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Text="二游日历" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind Vm.HeaderCount, Mode=OneWay}" />
                </StackPanel>
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Vm.StatusText, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind Vm.StatusTip, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,46,0">
                <ProgressRing
                    x:Name="BusyRing"
                    Width="16"
                    Height="16"
                    IsActive="False"
                    Visibility="Collapsed" />
                <Button
                    x:Name="RefreshButton"
                    Click="OnRefreshClick"
                    ToolTipService.ToolTip="立即刷新（数据源每 6 小时更新一次）">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock Text="刷新" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 列头 -->
        <Grid Grid.Row="1" Padding="4,0" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="175" />
                <ColumnDefinition Width="125" />
                <ColumnDefinition Width="175" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="游戏" />
            <TextBlock Grid.Column="1" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="当期卡池" />
            <TextBlock Grid.Column="2" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="卡池起止" />
            <TextBlock Grid.Column="3" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="当期活动" />
            <TextBlock Grid.Column="4" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="活动起止" />
        </Grid>

        <!-- 行列表 -->
        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                <ItemsControl ItemsSource="{x:Bind Vm.Rows, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RowVm">
                            <Border BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="4,7">
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="175" />
                                        <ColumnDefinition Width="125" />
                                        <ColumnDefinition Width="175" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 游戏名 + 状态 badge -->
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <controls:GameIcon Glyph="{x:Bind Name}" IconUrl="{x:Bind IconUrl}" />
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                MaxLines="1"
                                                Text="{x:Bind Name}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind Name}" />
                                            <Grid>
                                                <!-- 报错 badge（红） -->
                                                <Border
                                                    Padding="5,1"
                                                    Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                                    CornerRadius="4"
                                                    Visibility="{x:Bind BadgeKind, Converter={StaticResource KindEquals}, ConverterParameter=err, Mode=OneWay}">
                                                    <TextBlock
                                                        FontSize="10"
                                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                        Text="{x:Bind BadgeText, Mode=OneWay}" />
                                                </Border>
                                                <!-- 未公布 / 沿用旧数据（中性） -->
                                                <Border
                                                    Padding="5,1"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                    CornerRadius="4">
                                                    <Border.Visibility>
                                                        <Binding
                                                            Converter="{StaticResource KindEquals}"
                                                            ConverterParameter="warn"
                                                            Mode="OneWay"
                                                            Path="BadgeKind" />
                                                    </Border.Visibility>
                                                    <TextBlock
                                                        FontSize="10"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind BadgeText, Mode=OneWay}" />
                                                </Border>
                                                <Border
                                                    Padding="5,1"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                    CornerRadius="4">
                                                    <Border.Visibility>
                                                        <Binding
                                                            Converter="{StaticResource KindEquals}"
                                                            ConverterParameter="stale"
                                                            Mode="OneWay"
                                                            Path="BadgeKind" />
                                                    </Border.Visibility>
                                                    <TextBlock
                                                        FontSize="10"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Text="{x:Bind BadgeText, Mode=OneWay}" />
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 卡池名（隐藏时收起整列内容） -->
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        MaxLines="2"
                                        Text="{x:Bind GachaText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap"
                                        ToolTipService.ToolTip="{x:Bind GachaTip, Mode=OneWay}"
                                        Visibility="{x:Bind ShowGacha, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />

                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        MaxLines="2"
                                        Text="{x:Bind GachaDateText, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        ToolTipService.ToolTip="{x:Bind GachaDateTip, Mode=OneWay}"
                                        Visibility="{x:Bind ShowGacha, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />

                                    <TextBlock
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        MaxLines="2"
                                        Text="{x:Bind EventText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap"
                                        ToolTipService.ToolTip="{x:Bind EventTip, Mode=OneWay}"
                                        Visibility="{x:Bind ShowEvent, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />

                                    <TextBlock
                                        Grid.Column="4"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        MaxLines="2"
                                        Text="{x:Bind EventDateText, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        ToolTipService.ToolTip="{x:Bind EventDateTip, Mode=OneWay}"
                                        Visibility="{x:Bind ShowEvent, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 错误态 -->
            <StackPanel
                x:Name="ErrorPanel"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="6"
                Visibility="Collapsed">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="载入失败" />
                <TextBlock
                    x:Name="ErrorText"
                    HorizontalAlignment="Center"
                    MaxWidth="520"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- 底部：数据时间 + 说明 -->
        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                FontSize="11"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="{x:Bind Vm.UpdatedText, Mode=OneWay}" />
            <TextBlock
                Grid.Column="1"
                HorizontalAlignment="Right"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="非官方信息聚合 · 数据每 6 小时更新 · 齿轮可设置" />
        </Grid>
    </Grid>
</UserControl>
