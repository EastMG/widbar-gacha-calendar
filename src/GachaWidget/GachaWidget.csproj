<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WidBar 任务栏小组件（WinUI 3，单项目 MSIX）。
    - 目标框架与 WidBar 官方模板一致：net10.0-windows10.0.19041.0
    - Windows App SDK **自包含**：WidBar 用 widbar-pipe 参数直接拉起 exe，环境里没有
      可用的 WindowsAppRuntime 2.x 动态依赖（DDLM）时，框架依赖模式会在自动初始化阶段
      抛 REGDB_E_CLASSNOTREG（DeploymentInitializeOptions），表现为宿主只看到
      "Plugin process exited"。体积换可启动性，见 docs/03。
    - 体积：只引 WinUI 所需的 Windows App SDK 子包，并对元包 / AI / ML / Widgets
      加 ExcludeAssets，避免把 ~110MB 的 onnxruntime + DirectML 带进安装包
      （实测 msix 85.31MB → 32.71MB，见 _widbar_spike/REPORT.md §10）。
    - TFM / 插件属性改动会影响 WidBar 的发现，先看 docs/03-WidBar插件契约.md
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>GachaWidget</RootNamespace>
    <AssemblyName>GachaWidget</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- 单 RID + 单平台：多架构会把其它架构的 native payload 一起打进包 -->
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <SelfContained>false</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!-- 体积：不生成符号、只留中文与英文卫星资源 -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <NeutralLanguage>zh-Hans</NeutralLanguage>

    <Version>0.1.17</Version>
    <Authors>EastMG</Authors>
    <Company>EastMG</Company>
    <Product>二游日历 for WidBar</Product>
    <Description>28 款二游的卡池与活动倒计时，常驻 Windows 11 任务栏。</Description>
    <Copyright>MIT © 2026 EastMG</Copyright>

    <!-- WidBar SDK 的 build target 会用这些属性生成 obj\widbar\plugin.json（不要手写） -->
    <WidBarPluginId>com.eastmg.gachacalendar</WidBarPluginId>
    <WidBarPluginName>二游日历</WidBarPluginName>
    <WidBarPluginDescription>28 款二游的卡池与活动倒计时，常驻 Windows 11 任务栏。</WidBarPluginDescription>
    <WidBarPluginCategory>Information</WidBarPluginCategory>
    <WidBarPluginVersion>0.1.17</WidBarPluginVersion>
    <WidBarPluginPreviewWidth>372</WidBarPluginPreviewWidth>
    <WidBarPluginConfigurable>true</WidBarPluginConfigurable>
    <WidBarPluginMinHostVersion>1.0.0</WidBarPluginMinHostVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- 只引需要的 WinAppSDK 2.3.1 子包 -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.0.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.3" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.1.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.3.1" />

    <!-- 压住 WidBar.SDK 传递进来的元包与 AI/ML/Widgets（构建 0 error，包内无 onnxruntime/DirectML） -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="2.3.4" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.1.74" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="2.0.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.1.74" ExcludeAssets="all" />

    <PackageReference Include="WidBar.SDK" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GachaCalendar.Core\GachaCalendar.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
    <Manifest Include="$(ApplicationManifest)" />
    <Content Include="Assets\**\*.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- plugin.json 由 WidBar.SDK.targets 生成到 obj\widbar，打包时变成 Public\plugin.json -->
    <Content Include="obj\widbar\plugin.json" Link="Public\plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
