<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 rescap">

  <!-- Publisher 必须与签名证书 / 商店身份一致；Store 侧发布时以 Partner Center 为准 -->
  <Identity
    Name="EastMG.GachaCalendar"
    Publisher="CN=EastMG"
    Version="0.1.22.0" />

  <Properties>
    <DisplayName>二游日历 for WidBar</DisplayName>
    <PublisherDisplayName>EastMG</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>28 款二游的卡池与活动倒计时，常驻 Windows 11 任务栏。</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="zh-Hans" />
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="GachaWidget.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="二游日历"
        Description="28 款二游的卡池与活动倒计时，常驻 Windows 11 任务栏。"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- WidBar 靠这个 AppExtension 发现组件 -->
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension
            Name="com.widbar.widget"
            Id="gacha-calendar"
            PublicFolder="Public"
            DisplayName="二游日历"
            Description="28 款二游的卡池与活动倒计时，常驻 Windows 11 任务栏。">
            <uap3:Properties>
              <WidBarPluginId>com.eastmg.gachacalendar</WidBarPluginId>
              <WidBarSdkVersion>2</WidBarSdkVersion>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
